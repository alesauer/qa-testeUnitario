{
  "info": {
    "name": "Sistema Login QA",
    "description": "Suíte de testes de API para https://qa.sauer.pro.br",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://qa.sauer.pro.br",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Carregar Página de Login",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Contém o título esperado no HTML\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Sistema Login QA\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Carregar Documentação",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documentacao",
          "host": ["{{baseUrl}}"],
          "path": ["documentacao"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Contém a seção de documentação\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Documentação\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Carregar Guia de Instalação do JMeter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instalacao-jmeter",
          "host": ["{{baseUrl}}"],
          "path": ["instalacao-jmeter"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Contém o guia de instalação\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"JMeter\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Login com Sucesso",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "usuario", "value": "admin", "type": "text" },
            { "key": "senha", "value": "123456", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code deve ser 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Mensagem de boas-vindas exibida\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Bem-vindo, admin!\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Login Falha - Senha Incorreta",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "usuario", "value": "admin", "type": "text" },
            { "key": "senha", "value": "senha_errada", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code final deve ser 200 após redirect\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Exibe mensagem de erro na tela\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Usuário ou senha inválidos.\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Login Falha - Usuário Inexistente",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "usuario", "value": "nao_existe", "type": "text" },
            { "key": "senha", "value": "123", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/login",
          "host": ["{{baseUrl}}"],
          "path": ["login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code final deve ser 200 após redirect\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Exibe mensagem de erro na tela\", function () {",
              "    pm.expect(pm.response.text()).to.include(\"Usuário ou senha inválidos.\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}